{
  "cleanupPeriodDays": 3650,
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__navigate"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "skillOverrides": {
    "ahs": "off",
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-approve-bash"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "slack@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "feedbackSurveyState": {
    "lastShownTime": 1754000331023
  }
}
